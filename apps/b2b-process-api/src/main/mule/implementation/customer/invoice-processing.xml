<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os" xmlns:json="http://www.mulesoft.org/schema/mule/json"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/json http://www.mulesoft.org/schema/mule/json/current/mule-json.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<sub-flow name="outbound-invoice-processing-subflow" doc:id="06e87453-aa24-4240-ac71-df7103f55bef" >
		<logger level="INFO" doc:name="LOG INFO : START" doc:id="de22f5c5-fc90-4e14-9e5a-1b635228c0d8" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	event: &quot;START&quot;,&#10;	flow: flow.name,&#10;	application: app.name,&#10;	environment: p('mule.env'),&#10;	timestamp: now(),&#10;	correlationId: vars.initialVariables.correlationId,&#10;	sourceSystem: &quot;P21&quot;,&#10;	targetSystem: &quot;APM - Anypoint Partner Manager&quot;&#10;}]" />
		<choice doc:name="Choice" doc:id="9eb79dc8-60dd-43ce-9307-c80c36725630" >
			<when expression="#[attributes.queryParams.startTime != null and attributes.queryParams.endTime != null]">
				<ee:transform doc:name="var: httpOperation" doc:id="29b1dbc7-6b33-4a28-aeb2-ac4bf3de1d89" >
					<ee:message >
					</ee:message>
					<ee:variables >
						<ee:set-variable resource="dwl/outbound-invoice-processing-subflow/v_httpOperationWhenCondition.dwl" variableName="httpOperation" />
					</ee:variables>
				</ee:transform>
			</when>
			<otherwise >
				<os:retrieve doc:name="InvoiceLastRunTimestamp" doc:id="589e6dea-666d-4387-8ad6-e2b770968166" objectStore="Outbound_Transction_Object_Store" key="InvoiceLastRunTimestamp" target="invoiceTimeStamp">
					<os:default-value ><![CDATA[#[%dw 2.0
output application/json
---
(now() - |P1D|) >> 'America/New_York' as String {format: 'yyyy-MM-dd\'T\'HH:mm:ss.SXX'}]]]></os:default-value>
		</os:retrieve>
				<ee:transform doc:name="var : httpOperation - get invoice Data" doc:id="ab0afd4b-e630-49be-b19c-8c64728df459">
			<ee:message />
			<ee:variables>
						<ee:set-variable resource="dwl/outbound-invoice-processing-subflow/v_httpOperationDefaultCondition.dwl" variableName="httpOperation" />
			</ee:variables>
		</ee:transform>
			</otherwise>
		</choice>
		<flow-ref doc:name="Flow Reference To commom-http-request-subflow" doc:id="f3020b94-7a8d-43c7-b187-89d5b377d1ca" name="common-http-request-subflow" target="invoiceData" />
		<ee:transform doc:name="View to CDM transformation" doc:id="3f76f0fb-2f75-41eb-93f5-d60feed5ff34" >
			<ee:message >
				<ee:set-payload resource="dwl/outbound-invoice-processing-subflow/p_cdmMapping.dwl" />
			</ee:message>
		</ee:transform>
		<logger level="DEBUG" doc:name="LOG DEBUG:  Parallel for each" doc:id="3ff6576c-9421-4abe-9a7d-db8f1c557e4c" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	event: "Parllel for each process started",&#10;	flow: flow.name,&#10;	application: app.name,&#10;	timestamp: now(),&#10;	correlationId: vars.initialVariables.correlationId,&#10;	poMapping: payload&#10;}]' category="${logger.debug.category}" />
		<parallel-foreach doc:name="Parallel For Each : Iteration over POs" doc:id="abe87cef-3032-4d2e-af52-12ddc1652c48" collection="#[payload]" >
			<try doc:name="Try" doc:id="9c6d8347-48ac-4d9d-8a60-0110cde43ef2" >
				<json:validate-schema doc:name="Validate Incoming Payload" doc:id="9a90c357-2d9f-4818-9bbd-e7134b5d2327" schema="schema/INVOICE_OUTBOUND_JSON_SCHEMA.json" />
				<ee:transform doc:name="var: httpOperation- post APM" doc:id="2ad6dce5-c563-447a-989e-842d10a3179e" >
					<ee:message />
					<ee:variables >
						<ee:set-variable resource="dwl/outbound-invoice-processing-subflow/v_httpOperationApm.dwl" variableName="httpOperation" />
					</ee:variables>
				</ee:transform>
				<logger level="DEBUG" doc:name="Log DEBUG: APM Request" doc:id="a3ef7986-2c97-44be-8d6f-fa9a5d92bf33" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	event: &quot;APM flow start&quot;,&#10;	flow: flow.name,&#10;	application: app.name,&#10;	environment: Mule::p('mule.env'),&#10;	timestamp: now(),&#10;	correlationId: vars.initialVariables.correlationId&#10;}]" category="${logger.debug.category}" />
				<flow-ref doc:name="Flow Reference To commom-http-request-subflow" doc:id="82c0f16d-e908-4395-9886-3d2a824b8e42" name="common-http-request-subflow" target="transmissionId" targetValue="#[attributes.headers.'x-apm-trx-id']" />
				<logger level="DEBUG" doc:name="LOG DEBUG: APM Response" doc:id="eb82f16a-bc31-4459-b8ae-2582b649f727" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	event: &quot;APM flow ended&quot;,&#10;	flow: flow.name,&#10;	application: app.name,&#10;	environment: Mule::p('mule.env'),&#10;	timestamp: now(),&#10;	correlationId: vars.initialVariables.correlationId,&#10;	transmissionId: vars.transmissionId&#10;}]" category="${logger.debug.category}" />
				<ee:transform doc:name="Transaction api payload  transformation" doc:id="b4519cf8-c1e4-43a3-a0f9-0e7dec527555" >
					<ee:message >
						<ee:set-payload resource="dwl/outbound-invoice-processing-subflow/p_apmResponse.dwl" />
					</ee:message>
				</ee:transform>
				<error-handler >
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="1627dbc6-0e69-48c2-9a5c-574b286da3dd" >
						<ee:transform doc:name="var : httpStatus" doc:id="9ad8d62f-65c7-4c13-84ce-25dc64368664" >
							<ee:message />
							<ee:variables >
								<ee:set-variable resource="dwl/outbound-invoice-processing-subflow/v_httpStatusError.dwl" variableName="httpStatus" />
							</ee:variables>
						</ee:transform>
						<ee:transform doc:name="Preparing error payload for transaction api" doc:id="bb6820c8-3492-45ab-a8b0-92e46c9ffa27" >
							<ee:message >
								<ee:set-payload resource="dwl/outbound-invoice-processing-subflow/p_errorPayloadTransactionApi.dwl" />
							</ee:message>
						</ee:transform>
						<logger level="INFO" doc:name="LOG INFO : Error" doc:id="259638fa-9f86-4adf-9b6c-8c519acd1f0f" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	event: "Errored PO",&#10;	flow: flow.name,&#10;	application: app.name,&#10;	timestamp: now(),&#10;	correlationId: vars.initialVariables.correlationId,&#10;	poSummary: payload&#10;}]' />
					</on-error-continue>
				</error-handler>
			</try>
		</parallel-foreach>
		<ee:transform doc:name="var: errorInvoices" doc:id="ed55e5a5-b815-4264-bcb6-a64f0dbb277a" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable resource="dwl/outbound-invoice-processing-subflow/v_errorInvoices.dwl" variableName="errorInvoices" />
			</ee:variables>
		</ee:transform>
		<choice doc:name="Choice" doc:id="8e5eb359-210c-488e-9bee-d60a07c08f57" >
			<when expression="#[isEmpty(vars.requestParams)]">
				<os:store doc:name="InvoiceLastRunTimestamp" doc:id="2e22e55b-f7ce-4699-a03d-f9894bb7348f" key="InvoiceLastRunTimestamp" objectStore="Outbound_Transction_Object_Store">
			<os:value><![CDATA[#[vars.initialVariables.timestamp]]]></os:value>
		</os:store>
			</when>
		</choice>
		<foreach doc:name="For Each: Iteration Over Errored POs" doc:id="419b7e8b-9b4d-49b5-8b84-3aba967bc927" collection="#[vars.errorInvoices]">
			<ee:transform doc:name="Preparing Email Template, var : subject, vendorName" doc:id="5773ae1f-6d59-4f7f-919e-d1d2f1a0b4c0" >
				<ee:message >
					<ee:set-payload resource="dwl/outbound-invoice-processing-subflow/p_emailBody.dwl" />
				</ee:message>
				<ee:variables >
					<ee:set-variable resource="dwl/outbound-invoice-processing-subflow/v_vendorName.dwl" variableName="vendorName" />
					<ee:set-variable resource="dwl/outbound-invoice-processing-subflow/v_emailSubject.dwl" variableName="subject" />
				</ee:variables>
			</ee:transform>
			<flow-ref doc:name="Flow Reference To send-email-subflow" doc:id="cc1c3bd0-ffe2-41a9-894a-9a251a50e3e1" name="send-email-subflow" />
		</foreach>
		<logger level="INFO" doc:name="LOG INFO : END" doc:id="ddf04fe3-e117-447a-8d2d-5c1616265ea2" message="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;	event: &quot;END&quot;,&#10;	flow: flow.name,&#10;	application: app.name,&#10;	environment: p('mule.env'),&#10;	timestamp: now(),&#10;	correlationId: vars.initialVariables.correlationId,&#10;	sourceSystem: &quot;P21&quot;,&#10;	targetSystem: &quot;APM - Anypoint Partner Manager&quot;&#10;}]" />
	</sub-flow>
</mule>
